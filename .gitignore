# Allowlist; never switch to a blocklist. Anything new in ~/.claude
# (credentials, session state) must stay ignored by default.
/*
!/.gitignore
!/README.md
!/settings.sync.json
!/statusline.sh
!/rules
!/skills
# Claude Code writes these through the ~/.claude/skills symlink.
/skills/synced/
/skills/.trash/
# Unanchored: unlike the allowlist, these also apply inside rules/ and skills/.
.DS_Store
.credentials.json
